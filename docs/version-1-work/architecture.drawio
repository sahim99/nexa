          <mxGeometry x="740" y="85" width="100" height="45" as="geometry" />
        </mxCell>
        <mxCell id="voice" value="🎤 Voice&#xa;(P9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e0e0;strokeColor=#9e9e9e;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="860" y="85" width="100" height="45" as="geometry" />
        </mxCell>

        <!-- Arrow: User → Interaction -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565c0;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="user-group" target="interaction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== LAYER 1: INTERACTION AGENT ==================== -->
        <mxCell id="interaction" value="🗣️ INTERACTION AGENT&#xa;&#xa;• Understand conversational requests&#xa;• Resolve context (user profile, memory)&#xa;• Ask clarification when genuinely needed&#xa;• Forward executable tasks to Manager&#xa;• Final user-facing communication&#xa;&#xa;⚠️ NO unrestricted write access&#xa;Inspired by: GAIA Comms Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="530" y="180" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="layer1-badge" value="LAYER 1" style="text;html=1;fontSize=9;fontStyle=1;fillColor=#1565c0;fontColor=#ffffff;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="170" width="55" height="16" as="geometry" />
        </mxCell>

        <!-- Arrow: Interaction → Manager -->
        <mxCell id="arrow2" value="typed AgentTask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6a1b9a;strokeWidth=2;fontSize=9;fontStyle=2;" edge="1" parent="1" source="interaction" target="manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== LAYER 2: MANAGER AGENT ==================== -->
        <mxCell id="manager" value="🧠 MANAGER AGENT&#xa;&#xa;• Understand user intent&#xa;• Retrieve profile, memory, permissions, state&#xa;• Select agents by capability (registry lookup)&#xa;• Create typed ExecutionPlan (DAG)&#xa;• Decompose complex work (parallel vs sequential)&#xa;• Decide when approval is required&#xa;• Replan failed tasks&#xa;• Synthesize verified results&#xa;&#xa;Inspired by: GAIA Executor Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#6a1b9a;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="530" y="350" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="layer2-badge" value="LAYER 2" style="text;html=1;fontSize=9;fontStyle=1;fillColor=#6a1b9a;fontColor=#ffffff;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="340" width="55" height="16" as="geometry" />
        </mxCell>

        <!-- Plan Compiler box inside Manager area -->
        <mxCell id="plan-compiler" value="📋 Plan Compiler&#xa;(Intent → DAG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ce93d8;strokeColor=#6a1b9a;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="900" y="370" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Arrow: Manager → Execution Engine -->
        <mxCell id="arrow3" value="ExecutionPlan (DAG)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#e65100;strokeWidth=2;fontSize=9;fontStyle=2;" edge="1" parent="1" source="manager" target="exec-engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== LAYER 3: EXECUTION ENGINE ==================== -->
        <mxCell id="exec-engine" value="⚙️ EXECUTION ENGINE&#xa;&#xa;• Execute durable DAGs&#xa;• Run independent tasks in parallel&#xa;• Maintain checkpoints (PostgreSQL)&#xa;• Retry with exponential backoff&#xa;• Resume after restart&#xa;• Handle cancellation + timeouts&#xa;• Enforce budgets (steps, LLM calls, cost)&#xa;• Pause for approval → resume after&#xa;• Track task state machine&#xa;&#xa;Inspired by: GAIA background runner + LifeOS agent worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="530" y="540" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="layer3-badge" value="LAYER 3" style="text;html=1;fontSize=9;fontStyle=1;fillColor=#e65100;fontColor=#ffffff;rounded=1;spacingLeft=4;spacingRight=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="530" width="55" height="16" as="geometry" />
        </mxCell>

        <!-- Arrow: Exec Engine → Specialists -->
        <mxCell id="arrow4" value="AgentTask per node" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00695c;strokeWidth=2;fontSize=9;fontStyle=2;" edge="1" parent="1" source="exec-engine" target="specialists-group">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

