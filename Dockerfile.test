FROM node:22-slim

WORKDIR /app

RUN apt-get update && apt-get install -y openssl git curl && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
COPY e2e ./e2e

RUN npm install --include=dev

ENV NODE_ENV=test

CMD ["npx", "vitest", "run", "e2e"]
