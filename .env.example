# Nexa environment variables
# Copy to .env (gitignored). Values below are placeholders, not real credentials.

# App ports
PORT_WEB=3000
PORT_API=3001
WEB_ORIGIN=http://localhost:3000

# Local docker-compose Postgres only. Replace for any shared database.
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_pass
POSTGRES_DB=nexa_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nexa_user:nexa_pass@localhost:5432/nexa_db?schema=public

# Auth. Change both before exposing the API.
JWT_SECRET=change-me
NEXA_ADMIN_USER=admin
NEXA_ADMIN_PASS=change-me

# LLM providers. Leave blank to skip that provider; the gateway falls through to the template.
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# Optional local model server
OLLAMA_BASE_URL=http://localhost:11434

# Tests only. The API refuses to boot fixture mode when NODE_ENV=production.
NEXA_FIXTURE_MODE=false

# Integrations. Not required for the agent LLM path.
N8N_URL=http://localhost:5678
N8N_API_KEY=
TELEGRAM_BOT_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001
