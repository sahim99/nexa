# Nexa Environment Variables

# App Ports
PORT_WEB=3000
PORT_API=3001

# Database Configuration
# These values correspond to the docker-compose setup
POSTGRES_USER=nexa_user
POSTGRES_PASSWORD=nexa_pass
POSTGRES_DB=nexa_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://nexa_user:nexa_pass@localhost:5432/nexa_db?schema=public"

# LLM APIs
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Services
N8N_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key_here

# Integrations
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here

# Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:3001
