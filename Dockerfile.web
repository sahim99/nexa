FROM node:22-slim

WORKDIR /app

# Copy configuration and web app
COPY package*.json ./
COPY tsconfig.base.json ./
COPY apps/web ./apps/web

# Install dependencies and build Next.js optimized production bundle
RUN npm install
RUN npm run build --workspace=@nexa/web

EXPOSE 3000
ENV PORT=3000
ENV NODE_ENV=production

CMD ["npx", "next", "start", "apps/web", "-p", "3000"]
